<Project Sdk="Microsoft.NET.Sdk">

  <!-- The app: Avalonia interface on top of ScreenCapture.Core and the platform backend.
       net9.0-windows is the Windows app; net9.0 is the Linux app. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFrameworks>net9.0-windows;net9.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AssemblyName>ScreenCapture</AssemblyName>
    <Product>Screen Capture</Product>
    <Copyright>Copyright (C) 2026 Bakou. Licensed under the GNU GPL v3 or later.</Copyright>
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net9.0-windows'">
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="app.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ScreenCapture.Core\ScreenCapture.Core.csproj" />
    <ProjectReference Include="..\ScreenCapture.Windows\ScreenCapture.Windows.csproj" Condition="'$(TargetFramework)' == 'net9.0-windows'" />
    <ProjectReference Include="..\ScreenCapture.Linux\ScreenCapture.Linux.csproj" Condition="'$(TargetFramework)' == 'net9.0'" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="FluentIcons.Avalonia" Version="1.1.310" />
  </ItemGroup>

</Project>
