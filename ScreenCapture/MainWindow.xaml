<ui:FluentWindow x:Class="ScreenCapture.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Screen Capture"
                 Icon="pack://application:,,,/app.ico"
                 Width="460"
                 SizeToContent="Height"
                 MinWidth="460"
                 MinHeight="320"
                 ResizeMode="CanResize"
                 WindowStartupLocation="CenterScreen"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 ExtendsContentIntoTitleBar="True">
    <ui:FluentWindow.Resources>
        <SolidColorBrush x:Key="RecordRed" Color="#E5484D" />

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16,12,16,16" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>

        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="2,0,0,4" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>

        <Style x:Key="KeyCap" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrongStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1,1,1,2" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="Margin" Value="0,0,4,0" />
        </Style>

        <Style x:Key="Tile" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Height" Value="72" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>

        <!-- Big round record button: red dot when idle, red rounded square while recording. -->
        <Style x:Key="RecordButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Width="84" Height="84" Background="Transparent">
                            <Ellipse x:Name="Ring" StrokeThickness="3" Stroke="{DynamicResource ControlStrongStrokeColorDefaultBrush}" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource RecordRed}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="Screen Capture" ShowMaximize="True">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/app.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- Scrolls only when the content does not fit, even at the smallest scale. -->
        <ScrollViewer x:Name="ContentScroller" Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <!-- Scaled up with the window; wide windows put the cards in two columns (see MainWindow.UpdateLayoutMode). -->
        <Border VerticalAlignment="Center">
            <Border.LayoutTransform>
                <ScaleTransform x:Name="UiScale" />
            </Border.LayoutTransform>
        <Grid x:Name="LayoutRoot" Margin="16,4,16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition x:Name="ColumnGap" Width="0" />
                <ColumnDefinition x:Name="RightColumnDef" Width="0" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel x:Name="LeftColumn" Grid.Column="0">

            <!-- Capture zone -->
            <Border x:Name="CaptureCard" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="Capture" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <ui:Button x:Name="RegionTile" Grid.Column="0" Style="{StaticResource Tile}" Click="RegionTile_Click"
                                   ToolTip="Draw the zone to record">
                            <StackPanel>
                                <ui:SymbolIcon Symbol="Crop24" FontSize="22" HorizontalAlignment="Center" />
                                <TextBlock Text="Region" Margin="0,6,0,0" HorizontalAlignment="Center" />
                            </StackPanel>
                        </ui:Button>
                        <ui:Button x:Name="ScreenTile" Grid.Column="2" Style="{StaticResource Tile}" Click="ScreenTile_Click"
                                   ToolTip="Record a whole screen">
                            <StackPanel>
                                <ui:SymbolIcon Symbol="Desktop24" FontSize="22" HorizontalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0" HorizontalAlignment="Center">
                                    <TextBlock Text="Screen" />
                                    <ui:SymbolIcon x:Name="ScreenChevron" Symbol="ChevronDown12" FontSize="10" Margin="5,2,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                        </ui:Button>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="2,12,0,0">
                        <ui:SymbolIcon x:Name="ZoneIcon" Symbol="Checkmark24" FontSize="14" Margin="0,0,6,0"
                                       Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                        <TextBlock x:Name="ZoneLabel" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Video -->
            <Border x:Name="VideoCard" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="Video" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.8*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource Caption}" Text="Format" />
                            <ComboBox x:Name="FormatBox" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource Caption}" Text="Quality" />
                            <ComboBox x:Name="QualityBox" />
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Style="{StaticResource Caption}" Text="Frame rate" />
                            <ComboBox x:Name="FpsBox" />
                        </StackPanel>
                    </Grid>

                    <ui:ToggleSwitch x:Name="CursorSwitch" Content="Show mouse cursor" Margin="0,14,0,0" />
                    <ui:ToggleSwitch x:Name="BorderSwitch" Content="Red frame around the zone while recording" Margin="0,10,0,0"
                                     ToolTip="Turn off when recording a game: a window above it can lower its frame rate" />

                    <TextBlock Style="{StaticResource Caption}" Text="Save to" Margin="2,14,0,4" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox x:Name="FolderBox" Grid.Column="0" ClearButtonEnabled="False" />
                        <ui:Button x:Name="BrowseButton" Grid.Column="1" Margin="8,0,0,0" Height="34" Click="Browse_Click"
                                   Icon="{ui:SymbolIcon Folder24}" ToolTip="Choose folder" />
                        <ui:Button Grid.Column="2" Margin="6,0,0,0" Height="34" Click="OpenFolder_Click"
                                   Icon="{ui:SymbolIcon FolderOpen24}" ToolTip="Open folder" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Sound -->
            <Border x:Name="SoundCard" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="Sound" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <ui:ToggleSwitch x:Name="SysAudioSwitch" Grid.Row="0" Grid.Column="0" Content="System sound" />
                        <ComboBox x:Name="SysDeviceBox" Grid.Row="0" Grid.Column="1" />

                        <!-- Which apps' sound to record -->
                        <StackPanel x:Name="AppsPanel" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,10,0,0">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="AllAppsRadio" Content="All apps" GroupName="AppAudio" MinWidth="0" Margin="0,0,16,0" />
                                <RadioButton x:Name="OnlyAppsRadio" Content="Only selected apps" GroupName="AppAudio" MinWidth="0" />
                            </StackPanel>
                            <Border x:Name="AppsListBorder" Margin="0,8,0,0" CornerRadius="6" BorderThickness="1"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    Background="{DynamicResource ControlFillColorDefaultBrush}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0" Margin="12,6,4,2">
                                        <TextBlock Text="Apps playing sound" FontSize="12" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <ui:Button HorizontalAlignment="Right" Appearance="Transparent" Padding="6,4" BorderThickness="0"
                                                   Icon="{ui:SymbolIcon ArrowSync16}" ToolTip="Refresh the list" Click="RefreshApps_Click" />
                                    </Grid>
                                    <ScrollViewer Grid.Row="1" MaxHeight="160" VerticalScrollBarVisibility="Auto">
                                        <StackPanel Margin="12,0,12,8">
                                            <ItemsControl x:Name="AppsList">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <CheckBox IsChecked="{Binding Selected}" MinWidth="0" Margin="0,2">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding Status}" Margin="8,0,0,0" FontSize="12" VerticalAlignment="Center"
                                                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                                            </StackPanel>
                                                        </CheckBox>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock x:Name="NoAppsText" TextWrapping="Wrap" FontSize="12" Margin="0,4,0,4"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       Text="No app is playing sound right now. Start playing something, then refresh." />
                                        </StackPanel>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                            <TextBlock x:Name="AppsHint" Margin="2,6,0,0" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Text="Selected apps must be running when recording starts." />
                        </StackPanel>

                        <ui:ToggleSwitch x:Name="MicSwitch" Grid.Row="3" Grid.Column="0" Content="Microphone" />
                        <ComboBox x:Name="MicDeviceBox" Grid.Row="3" Grid.Column="1" />
                    </Grid>
                    <TextBlock x:Name="SoundHint" Margin="2,10,0,0" FontSize="12" Visibility="Collapsed"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                </StackPanel>
            </Border>

            <!-- Record -->
            <StackPanel x:Name="RecordPanel" Margin="0,10,0,0" HorizontalAlignment="Center">
                <Button x:Name="RecordButton" Style="{StaticResource RecordButtonStyle}" Click="Record_Click" ToolTip="Start recording">
                    <Border x:Name="RecordDot" Width="60" Height="60" CornerRadius="30" Background="{StaticResource RecordRed}" />
                </Button>
                <TextBlock x:Name="TimerText" Text="00:00:00" Margin="0,10,0,0" HorizontalAlignment="Center"
                           FontSize="22" FontWeight="SemiBold" FontFamily="Segoe UI Variable Display, Segoe UI"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="StatusText" Text="Ready" Margin="0,2,0,0" HorizontalAlignment="Center"
                           TextTrimming="CharacterEllipsis" MaxWidth="400"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            </StackPanel>
            </StackPanel>
            <StackPanel x:Name="RightColumn" Grid.Column="2" Visibility="Collapsed" />

            <!-- Footer -->
            <Grid Grid.Row="1" Grid.ColumnSpan="3" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" ToolTip="Global shortcut to start / stop">
                    <Border Style="{StaticResource KeyCap}"><TextBlock Text="Ctrl" FontSize="11" /></Border>
                    <Border Style="{StaticResource KeyCap}"><TextBlock Text="Shift" FontSize="11" /></Border>
                    <Border Style="{StaticResource KeyCap}"><TextBlock Text="F9" FontSize="11" /></Border>
                    <TextBlock Text="start / stop" Margin="4,0,0,0" FontSize="12" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ui:Button x:Name="OpenFileButton" Appearance="Transparent" Icon="{ui:SymbolIcon Play24}" Content="Open video"
                               Visibility="Collapsed" Click="OpenFile_Click" Margin="0,0,4,0" />
                    <ui:Button Appearance="Transparent" Icon="{ui:SymbolIcon FolderOpen24}" Content="Folder" Click="OpenFolder_Click" />
                </StackPanel>
            </Grid>
        </Grid>
        </Border>
        </ScrollViewer>
    </Grid>
</ui:FluentWindow>
